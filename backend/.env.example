# Copy to backend/.env and fill in GEMINI_API_KEY. Everything else is optional.
# Only app/config.py reads these.

# --- Gemini (the only model/vendor). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=30000
# Longer limit for reading a whole uploaded document (topic extraction)
GEMINI_LONG_TIMEOUT_MS=90000
# Embeddings for note search (meaning, not only matching words)
GEMINI_EMBED_MODEL=gemini-embedding-001
# Live voice tutor (verify IDs with: python scripts/check_gemini.py)
GEMINI_LIVE_MODEL=gemini-3.8-live
LIVE_VOICE=Kore
LIVE_AFFECTIVE_DIALOG=false
SESSION_CAP_SECONDS=840

# --- Server
HOST=0.0.0.0
PORT=5000
RELOAD=false
# Comma-separated origins allowed to call the API; * allows any (fine for local development)
CORS_ORIGINS=*
LOG_LEVEL=INFO
MAX_UPLOAD_MB=10

# --- Data
# DB_PATH=data/eklavya.db
# Postgres (e.g. Neon) instead of the SQLite file: needed on hosts with no persistent disk (Render free plan).
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# SAMPLES_DIR=../samples
DEMO_USER_ID=1
# Signs login tokens. Set a long random value in production (e.g. python -c "import secrets;print(secrets.token_hex(32))").
# Left empty, a random one is created in the data folder.
# AUTH_SECRET=

# --- Accounts, email and reminders. Each feature stays off until its settings are set.
# Where the frontend runs (links in emails point here)
APP_URL=http://localhost:3000
# Google sign-in: an OAuth "Web application" client id from console.cloud.google.com (add the frontend address
# under "Authorized JavaScript origins")
# GOOGLE_CLIENT_ID=
# Email (password reset links, email reminders). Gmail: turn on 2-step verification, then create an app password
# at https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-16-letter-app-password
# SMTP_FROM=Eklavya <you@gmail.com>
# Push notifications: create keys once with  python scripts/make_vapid_keys.py
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@gmail.com
# Protects POST /api/reminders/run, which a daily scheduler calls (see .github/workflows/reminders.yml)
# CRON_SECRET=
