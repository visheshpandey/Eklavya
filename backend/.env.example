# Copy to backend/.env and fill in GEMINI_API_KEY. Everything else is optional.
# Only app/config.py reads these.

# --- Gemini (the only model/vendor). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=30000
# Longer limit for reading a whole uploaded document (topic extraction)
GEMINI_LONG_TIMEOUT_MS=90000
# Live voice tutor (verify IDs with: python scripts/check_gemini.py)
GEMINI_LIVE_MODEL=gemini-3.8-live
LIVE_VOICE=Kore
LIVE_AFFECTIVE_DIALOG=false
SESSION_CAP_SECONDS=840

# --- Server
HOST=0.0.0.0
PORT=5000
RELOAD=false
# Comma-separated origins allowed to call the API; * allows any (fine for local development)
CORS_ORIGINS=*
LOG_LEVEL=INFO
MAX_UPLOAD_MB=10

# --- Data
# DB_PATH=data/studypilot.db
# SAMPLES_DIR=../samples
DEMO_USER_ID=1
